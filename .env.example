# Same Sky — environment configuration
#
# Every value here is OPTIONAL. Without a .env file the application falls back
# to the project's committed Firebase configuration and runs with no setup.
#
# Copy this file to `.env` and fill it in only when pointing Same Sky at a
# different Firebase project.
#
# Firebase web configuration is public by design — it identifies a project
# rather than authorising access. Access is controlled entirely by Realtime
# Database security rules, never by keeping these values secret.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
