{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || (root.child('users').child(auth.uid).child('pairId').isString() && (root.child('pairs').child(root.child('users').child(auth.uid).child('pairId').val()).child('partnerA').val() === $uid || root.child('pairs').child(root.child('users').child(auth.uid).child('pairId').val()).child('partnerB').val() === $uid) && (root.child('pairs').child(root.child('users').child(auth.uid).child('pairId').val()).child('partnerA').val() === auth.uid || root.child('pairs').child(root.child('users').child(auth.uid).child('pairId').val()).child('partnerB').val() === auth.uid)))",
        ".write": "auth != null && auth.uid === $uid && newData.exists()",
        ".validate": "newData.hasChildren(['uid', 'displayName', 'createdAt'])",
        "uid": {
          ".validate": "newData.val() === $uid"
        },
        "displayName": {
          ".validate": "newData.isString() && newData.val().length <= 100"
        },
        "email": {
          ".validate": "newData.isString() && newData.val().length <= 320"
        },
        "photoURL": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 2048)"
        },
        "pairId": {
          ".validate": "newData.isString() && (root.child('pairs').child(newData.val()).child('partnerA').val() === auth.uid || root.child('pairs').child(newData.val()).child('partnerB').val() === auth.uid)"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "lastSeen": {
          ".validate": "newData.isNumber()"
        },
        "preferences": {
          "theme": {
            ".validate": "newData.isString() && newData.val().matches(/^(light|dark|system)$/)"
          },
          "motion": {
            ".validate": "newData.isString() && newData.val().matches(/^(system|reduced)$/)"
          },
          "hemisphere": {
            ".validate": "newData.isString() && newData.val().matches(/^(northern|southern)$/)"
          },
          "ambientAudio": {
            ".validate": "newData.isBoolean()"
          },
          "ambientVolume": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1"
          },
          "$other": {
            ".validate": false
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "inviteCodes": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && newData.exists() && ( (!data.exists() && newData.child('ownerUid').val() === auth.uid && newData.child('pairId').isString() && root.child('pairs').child(newData.child('pairId').val()).child('partnerA').val() === auth.uid && newData.child('used').val() === false && newData.child('createdAt').isNumber() && newData.child('createdAt').val() <= now + 3600000) || (data.exists() && root.child('pairs').child(data.child('pairId').val()).child('partnerB').val() === auth.uid && newData.child('used').val() === true && newData.child('ownerUid').val() === data.child('ownerUid').val() && newData.child('pairId').val() === data.child('pairId').val() && newData.child('createdAt').val() === data.child('createdAt').val()) )",
        ".validate": "newData.hasChildren(['inviteCode', 'ownerUid', 'pairId', 'used', 'createdAt']) && $code.matches(/^[A-HJ-NP-Z2-9]{6}$/)",
        "inviteCode": {
          ".validate": "newData.val() === $code"
        },
        "ownerUid": {
          ".validate": "newData.isString() && newData.val().length <= 128"
        },
        "pairId": {
          ".validate": "newData.isString() && newData.val().length <= 128"
        },
        "used": {
          ".validate": "newData.isBoolean()"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "pairs": {
      "$pairId": {
        ".read": "auth != null && (data.child('partnerA').val() === auth.uid || data.child('partnerB').val() === auth.uid || !data.child('partnerB').exists())",
        ".write": "auth != null && newData.exists() && ( (!data.exists() && newData.child('partnerA').val() === auth.uid && !newData.child('partnerB').exists()) || (data.exists() && (data.child('partnerA').val() === auth.uid || data.child('partnerB').val() === auth.uid) && newData.child('partnerA').val() === data.child('partnerA').val() && newData.child('partnerB').val() === data.child('partnerB').val()) || (data.exists() && !data.child('partnerB').exists() && data.child('partnerA').val() !== auth.uid && newData.child('partnerB').val() === auth.uid && newData.child('partnerA').val() === data.child('partnerA').val() && newData.child('inviteCode').val() === data.child('inviteCode').val() && root.child('inviteCodes').child(data.child('inviteCode').val()).child('used').val() === false && root.child('inviteCodes').child(data.child('inviteCode').val()).child('pairId').val() === $pairId && root.child('inviteCodes').child(data.child('inviteCode').val()).child('createdAt').val() > now - 172800000) )",
        ".validate": "newData.hasChildren(['id', 'inviteCode', 'partnerA', 'status', 'worldId', 'createdAt']) && (!data.exists() || newData.child('createdAt').val() === data.child('createdAt').val())",
        "id": {
          ".validate": "newData.val() === $pairId"
        },
        "worldId": {
          ".validate": "newData.val() === $pairId"
        },
        "inviteCode": {
          ".validate": "newData.isString() && newData.val().matches(/^[A-HJ-NP-Z2-9]{6}$/)"
        },
        "partnerA": {
          ".validate": "newData.isString() && newData.val().length <= 128"
        },
        "partnerB": {
          ".validate": "newData.isString() && newData.val().length <= 128"
        },
        "status": {
          ".validate": "newData.isString() && newData.val().matches(/^(pending|active)$/)"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "worlds": {
      "$worldId": {
        ".read": "auth != null && (root.child('pairs').child($worldId).child('partnerA').val() === auth.uid || root.child('pairs').child($worldId).child('partnerB').val() === auth.uid)",
        ".write": "auth != null && (root.child('pairs').child($worldId).child('partnerA').val() === auth.uid || root.child('pairs').child($worldId).child('partnerB').val() === auth.uid) && newData.exists()",
        ".validate": "newData.hasChildren(['worldId', 'pairId', 'createdAt', 'totalEnergy', 'totalRituals', 'activeDays', 'sharedDays'])",
        "worldId": {
          ".validate": "newData.val() === $worldId"
        },
        "pairId": {
          ".validate": "newData.val() === $worldId"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "updatedAt": {
          ".validate": "newData.isNumber()"
        },
        "totalEnergy": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "totalRituals": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "activeDays": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "sharedDays": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "lastActiveDate": {
          ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
        },
        "contributions": {
          "$uid": {
            ".validate": "(root.child('pairs').child($worldId).child('partnerA').val() === $uid || root.child('pairs').child($worldId).child('partnerB').val() === $uid) && newData.hasChildren(['uid', 'energy', 'rituals', 'activeDays'])",
            "uid": {
              ".validate": "newData.val() === $uid"
            },
            "energy": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },
            "rituals": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },
            "activeDays": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },
            "lastActiveDate": {
              ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "worldHistory": {
      "$worldId": {
        ".read": "auth != null && (root.child('pairs').child($worldId).child('partnerA').val() === auth.uid || root.child('pairs').child($worldId).child('partnerB').val() === auth.uid)",
        "$date": {
          ".write": "auth != null && (root.child('pairs').child($worldId).child('partnerA').val() === auth.uid || root.child('pairs').child($worldId).child('partnerB').val() === auth.uid)",
          ".validate": "$date.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)",
          "date": {
            ".validate": "newData.val() === $date"
          },
          "energy": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "rituals": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "byPartner": {
            "$uid": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && (root.child('pairs').child($worldId).child('partnerA').val() === $uid || root.child('pairs').child($worldId).child('partnerB').val() === $uid)"
            }
          },
          "ritualIds": {
            "$index": {
              ".validate": "newData.isString() && newData.val().length <= 64"
            }
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "rituals": {
      "$worldId": {
        ".read": "auth != null && (root.child('pairs').child($worldId).child('partnerA').val() === auth.uid || root.child('pairs').child($worldId).child('partnerB').val() === auth.uid)",
        "$date": {
          "$uid": {
            ".write": "auth != null && (root.child('pairs').child($worldId).child('partnerA').val() === auth.uid || root.child('pairs').child($worldId).child('partnerB').val() === auth.uid) && auth.uid === $uid",
            "$ritualId": {
              ".validate": "newData.hasChildren(['ritualId', 'uid', 'date', 'honouredAt', 'energy'])",
              "ritualId": {
                ".validate": "newData.val() === $ritualId"
              },
              "uid": {
                ".validate": "newData.val() === $uid"
              },
              "date": {
                ".validate": "newData.val() === $date"
              },
              "honouredAt": {
                ".validate": "newData.isNumber()"
              },
              "energy": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
              },
              "note": {
                ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 500)"
              },
              "$other": {
                ".validate": false
              }
            }
          }
        }
      }
    },
    "ritualPlans": {
      "$worldId": {
        ".read": "auth != null && (root.child('pairs').child($worldId).child('partnerA').val() === auth.uid || root.child('pairs').child($worldId).child('partnerB').val() === auth.uid)",
        "$uid": {
          ".write": "auth != null && (root.child('pairs').child($worldId).child('partnerA').val() === auth.uid || root.child('pairs').child($worldId).child('partnerB').val() === auth.uid) && auth.uid === $uid",
          "uid": {
            ".validate": "newData.val() === $uid"
          },
          "ritualIds": {
            "$index": {
              ".validate": "newData.isString() && newData.val().length <= 64"
            }
          },
          "updatedAt": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "notes": {
      "$worldId": {
        ".read": "auth != null && (root.child('pairs').child($worldId).child('partnerA').val() === auth.uid || root.child('pairs').child($worldId).child('partnerB').val() === auth.uid)",
        "$date": {
          "$uid": {
            ".write": "auth != null && (root.child('pairs').child($worldId).child('partnerA').val() === auth.uid || root.child('pairs').child($worldId).child('partnerB').val() === auth.uid) && auth.uid === $uid",
            ".validate": "newData.hasChildren(['id', 'authorUid', 'body', 'vessel', 'createdAt'])",
            "id": {
              ".validate": "newData.isString() && newData.val().length <= 128"
            },
            "worldId": {
              ".validate": "newData.val() === $worldId"
            },
            "authorUid": {
              ".validate": "newData.val() === $uid"
            },
            "date": {
              ".validate": "newData.val() === $date"
            },
            "body": {
              ".validate": "newData.isString() && newData.val().length <= 280"
            },
            "vessel": {
              ".validate": "newData.isString() && newData.val().matches(/^(letter|gift|lantern|feather|stone)$/)"
            },
            "createdAt": {
              ".validate": "newData.isNumber()"
            },
            "openedAt": {
              ".write": "auth != null && (root.child('pairs').child($worldId).child('partnerA').val() === auth.uid || root.child('pairs').child($worldId).child('partnerB').val() === auth.uid) && auth.uid !== $uid && !data.exists() && newData.isNumber()",
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    },
    "journal": {
      "$worldId": {
        ".read": "auth != null && (root.child('pairs').child($worldId).child('partnerA').val() === auth.uid || root.child('pairs').child($worldId).child('partnerB').val() === auth.uid)",
        "$entryId": {
          ".write": "auth != null && (root.child('pairs').child($worldId).child('partnerA').val() === auth.uid || root.child('pairs').child($worldId).child('partnerB').val() === auth.uid) && (data.exists() ? data.child('authorUid').val() === auth.uid : newData.child('authorUid').val() === auth.uid)",
          ".validate": "newData.hasChildren(['id', 'authorUid', 'date', 'body', 'createdAt']) && newData.child('authorUid').val() === auth.uid",
          "id": {
            ".validate": "newData.val() === $entryId"
          },
          "worldId": {
            ".validate": "newData.val() === $worldId"
          },
          "authorUid": {
            ".validate": "newData.isString() && newData.val().length <= 128"
          },
          "date": {
            ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
          },
          "title": {
            ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 120)"
          },
          "body": {
            ".validate": "newData.isString() && newData.val().length <= 20000"
          },
          "mood": {
            ".validate": "newData.isString() && newData.val().matches(/^(bright|warm|steady|tender|heavy)$/)"
          },
          "createdAt": {
            ".validate": "newData.isNumber()"
          },
          "updatedAt": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "memories": {
      "$worldId": {
        ".read": "auth != null && (root.child('pairs').child($worldId).child('partnerA').val() === auth.uid || root.child('pairs').child($worldId).child('partnerB').val() === auth.uid)",
        "$memoryId": {
          ".write": "auth != null && (root.child('pairs').child($worldId).child('partnerA').val() === auth.uid || root.child('pairs').child($worldId).child('partnerB').val() === auth.uid) && (data.exists() ? data.child('authorUid').val() === auth.uid : newData.child('authorUid').val() === auth.uid)",
          ".validate": "newData.hasChildren(['id', 'authorUid', 'title', 'date', 'kind', 'createdAt']) && newData.child('authorUid').val() === auth.uid",
          "id": {
            ".validate": "newData.val() === $memoryId"
          },
          "worldId": {
            ".validate": "newData.val() === $worldId"
          },
          "authorUid": {
            ".validate": "newData.isString() && newData.val().length <= 128"
          },
          "title": {
            ".validate": "newData.isString() && newData.val().length <= 120"
          },
          "story": {
            ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 5000)"
          },
          "date": {
            ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
          },
          "kind": {
            ".validate": "newData.isString() && newData.val().length <= 32"
          },
          "image": {
            "data": {
              ".validate": "newData.isString() && newData.val().beginsWith('data:image/') && newData.val().length <= 1500000"
            },
            "width": {
              ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 4000"
            },
            "height": {
              ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 4000"
            },
            "bytes": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },
            "$other": {
              ".validate": false
            }
          },
          "createdAt": {
            ".validate": "newData.isNumber()"
          },
          "updatedAt": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "plans": {
      "$worldId": {
        ".read": "auth != null && (root.child('pairs').child($worldId).child('partnerA').val() === auth.uid || root.child('pairs').child($worldId).child('partnerB').val() === auth.uid)",
        "$periodKey": {
          ".write": "auth != null && (root.child('pairs').child($worldId).child('partnerA').val() === auth.uid || root.child('pairs').child($worldId).child('partnerB').val() === auth.uid)",
          "intentions": {
            "$intentionId": {
              ".validate": "newData.hasChildren(['id', 'text', 'authorUid', 'createdAt']) && (data.exists() ? newData.child('authorUid').val() === data.child('authorUid').val() : newData.child('authorUid').val() === auth.uid)",
              "text": {
                ".validate": "newData.isString() && newData.val().length <= 160"
              }
            }
          }
        }
      }
    },
    "timeline": {
      "$worldId": {
        ".read": "auth != null && (root.child('pairs').child($worldId).child('partnerA').val() === auth.uid || root.child('pairs').child($worldId).child('partnerB').val() === auth.uid)",
        "$eventId": {
          ".write": "auth != null && (root.child('pairs').child($worldId).child('partnerA').val() === auth.uid || root.child('pairs').child($worldId).child('partnerB').val() === auth.uid) && !data.exists() && newData.exists()",
          ".validate": "newData.hasChildren(['id', 'type', 'title', 'date', 'createdAt']) && (!newData.child('uid').exists() || newData.child('uid').val() === auth.uid)",
          "id": {
            ".validate": "newData.val() === $eventId"
          },
          "worldId": {
            ".validate": "newData.val() === $worldId"
          },
          "type": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "uid": {
            ".validate": "newData.isString() && newData.val().length <= 128"
          },
          "title": {
            ".validate": "newData.isString() && newData.val().length <= 200"
          },
          "detail": {
            ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 500)"
          },
          "date": {
            ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
          },
          "createdAt": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "moods": {
      "$worldId": {
        ".read": "auth != null && (root.child('pairs').child($worldId).child('partnerA').val() === auth.uid || root.child('pairs').child($worldId).child('partnerB').val() === auth.uid)",
        "$date": {
          ".validate": "$date.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)",
          "$uid": {
            ".write": "auth != null && (root.child('pairs').child($worldId).child('partnerA').val() === auth.uid || root.child('pairs').child($worldId).child('partnerB').val() === auth.uid) && auth.uid === $uid",
            ".validate": "newData.hasChildren(['mood', 'at'])",
            "mood": {
              ".validate": "newData.isString() && newData.val().matches(/^(happy|loved|calm|tender|sleepy|low)$/)"
            },
            "at": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    },
    "gardens": {
      "$worldId": {
        ".read": "auth != null && (root.child('pairs').child($worldId).child('partnerA').val() === auth.uid || root.child('pairs').child($worldId).child('partnerB').val() === auth.uid)",
        ".write": "auth != null && (root.child('pairs').child($worldId).child('partnerA').val() === auth.uid || root.child('pairs').child($worldId).child('partnerB').val() === auth.uid)",
        "weather": {
          ".validate": "newData.isString() && newData.val().matches(/^(clear|sunshine|rainbow|starry|aurora)$/)"
        },
        "plots": {
          "$plotId": {
            ".validate": "$plotId.matches(/^[0-5]$/) && newData.hasChildren(['seedId', 'plantedOn', 'plantedBy']) && (data.exists() || newData.child('plantedBy').val() === auth.uid)",
            "seedId": {
              ".validate": "newData.isString() && newData.val().matches(/^(sunflower|daisy|tulip|lavender|rose-bush|blueberry-bush|cherry-tree|apple-tree|orange-tree|mango-tree)$/)"
            },
            "plantedOn": {
              ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
            },
            "plantedBy": {
              ".validate": "newData.isString() && newData.val().length <= 128"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
